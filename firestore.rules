rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'pdushangana@gmail.com'
      );
    }

    function isOwner(userId) {
      return request.auth != null && (
        request.auth.uid == userId ||
        request.auth.token.email.lower() == userId.lower()
      );
    }

    match /test/{docId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      // Super Admin can read and write all users
      allow read, write: if isAdmin();
      
      // Authenticated users can read users
      allow read: if request.auth != null;

      // Authenticated users can create their own record
      allow create: if request.auth != null && (
        isOwner(userId) ||
        request.resource.data.email.lower() == request.auth.token.email.lower()
      );
      
      // Authenticated users can update their own record, but non-admins cannot change isPro or role
      allow update: if request.auth != null && (
        isAdmin() ||
        (
          (isOwner(userId) || resource.data.email.lower() == request.auth.token.email.lower()) &&
          request.resource.data.isPro == resource.data.isPro &&
          request.resource.data.role == resource.data.role
        )
      );

      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
